# Sandboxed runner for POST /api/scan. This image never runs as part of
# the backend API server itself - the backend (see src/services/scan/
# dockerRunner.js) launches two short-lived, --rm'd containers from this
# image per scan request (a network-enabled clone phase, then a
# --network none analyze phase sharing a volume with it), each reading
# back exactly one JSON line on stdout. See README security notes.
FROM node:24-alpine

# git: shallow-clones the target repo. Nothing else - we deliberately
# never run `npm install`/`npm ci` against a *cloned* repo (arbitrary
# install/postinstall scripts from untrusted code), so no build toolchain
# is needed beyond what's already in this base image.
RUN apk add --no-cache git

# Terraform tooling, used only when a scan detects .tf files (see
# src/services/scan/detectTerraform.js). None of these are Node packages, so
# they're installed here rather than coming from package-lock.json:
#   - checkov is a Python CLI. --break-system-packages because Alpine's
#     python3 is PEP-668 "externally managed"; that's a non-issue in a
#     single-purpose container with no other Python in it.
#   - tfsec and inframap ship static Go binaries. Both are pinned by version
#     *and* verified against a sha256 before they're ever made executable -
#     these are binaries we hand untrusted input to, so a silently-swapped
#     download shouldn't be able to become code execution.
#
# inframap is pinned to 0.8.0 deliberately: 0.8.1 is the latest tag but
# publishes no release binaries at all, so "latest" is not installable here.
ARG CHECKOV_VERSION=3.3.16
ARG TFSEC_VERSION=1.28.14
ARG TFSEC_SHA256=329ae7f67f2f1813ebe08de498719ea7003c75d3ca24bb0b038369062508008e
ARG INFRAMAP_VERSION=0.8.0
ARG INFRAMAP_SHA256=f1b5372c4a64393a7f67a21bed41a981eb4ca449480558dfd173717f41ffc213
RUN apk add --no-cache python3 py3-pip \
  && pip3 install --no-cache-dir --break-system-packages "checkov==${CHECKOV_VERSION}" \
  && wget -qO /tmp/tfsec.tar.gz \
    "https://github.com/aquasecurity/tfsec/releases/download/v${TFSEC_VERSION}/tfsec_${TFSEC_VERSION}_linux_amd64.tar.gz" \
  && echo "${TFSEC_SHA256}  /tmp/tfsec.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/tfsec.tar.gz -C /usr/local/bin tfsec \
  && wget -qO /tmp/inframap.tar.gz \
    "https://github.com/cycloidio/inframap/releases/download/v${INFRAMAP_VERSION}/inframap-linux-amd64.tar.gz" \
  && echo "${INFRAMAP_SHA256}  /tmp/inframap.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/inframap.tar.gz -C /tmp \
  && mv /tmp/inframap-linux-amd64 /usr/local/bin/inframap \
  && chmod +x /usr/local/bin/tfsec /usr/local/bin/inframap \
  && rm /tmp/tfsec.tar.gz /tmp/inframap.tar.gz

# Run as an unprivileged, non-root user so a compromised parser or a
# malicious repo's tooling has no elevated rights even inside the
# container's own namespace.
RUN addgroup -S scanner && adduser -S scanner -G scanner

WORKDIR /app

# Install only from this backend's own lockfile - the exact same
# eslint/eslint-plugin-sonarjs/madge/jscpd versions used everywhere else,
# not whatever the target repo happens to specify. --ignore-scripts:
# this image also has better-sqlite3 in its dependency tree (used only by
# the backend's own DB layer, never imported here - see the COPY below),
# and its install script compiles a native addon that needs Python/a C++
# toolchain we don't otherwise need in this image; skipping install
# scripts avoids that entirely (better-sqlite3 ends up inert and unused,
# which is fine - nothing under src/services/scan imports it).
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
  && chown -R scanner:scanner /app

# Only the scan pipeline itself - this image has no need for the rest of
# the backend (Express app, routes, dockerRunner.js).
COPY --chown=scanner:scanner src/services/scan ./src/services/scan

# Fingerprints the copy above and bakes the result into the image. Before
# every scan, dockerRunner.js recomputes this same hash from the host's own
# checkout and compares it against this file (`docker exec ... cat`) - a
# mismatch means this image predates a scan-pipeline change and the scan is
# refused with a loud error instead of silently running stale code (the
# exact failure mode this replaces: see the README).
RUN node src/services/scan/buildHash.mjs src/services/scan > /app/.scan-image-hash

USER scanner

# The root filesystem is mounted read-only at runtime (see dockerRunner.js's
# `--read-only`) with only /tmp writable (a tmpfs). npm writes cache/log
# files under $HOME by default, so point HOME there too - otherwise
# `npm audit` fails with EROFS instead of running.
ENV HOME=/tmp

# The phase script (and its args, if any) are supplied as the container's
# CMD, e.g.:
#   docker run --rm <image> src/services/scan/container/clonePhase.js <repoUrl>
#   docker run --rm <image> src/services/scan/container/analyzePhase.js
ENTRYPOINT ["node"]

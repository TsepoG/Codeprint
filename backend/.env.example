PORT=4000

# POST /api/scan runs inside a short-lived Docker container (see
# Dockerfile.scan-runner) - build it once before starting the backend:
#   docker build -f Dockerfile.scan-runner -t codeprint-scan-runner:latest .

# Timeouts enforced *inside* the container around clone/each tool/the
# whole scan (all in milliseconds). Forwarded into the container by
# dockerRunner.js if set here.
SCAN_CLONE_TIMEOUT_MS=30000
SCAN_TOOL_TIMEOUT_MS=60000
SCAN_TOTAL_TIMEOUT_MS=120000

# Host-side Docker orchestration (see src/services/scan/dockerRunner.js).
# SCAN_CONTAINER_TIMEOUT_MS should stay comfortably above
# SCAN_TOTAL_TIMEOUT_MS so the container gets a chance to self-terminate
# and report a clean timeout before the host force-kills it.
SCAN_IMAGE=codeprint-scan-runner:latest
SCAN_CONTAINER_TIMEOUT_MS=150000
SCAN_CONTAINER_MEMORY=512m
SCAN_CONTAINER_CPUS=1
SCAN_CONTAINER_PIDS_LIMIT=128

PORT=4000

# POST /api/scan runs across two short-lived Docker containers (see
# Dockerfile.scan-runner) - build the image once before starting the backend:
#   docker build -f Dockerfile.scan-runner -t codeprint-scan-runner:latest .

# Per-tool timeouts enforced *inside* the containers (all in milliseconds).
# Forwarded into both containers by dockerRunner.js if set here.
SCAN_CLONE_TIMEOUT_MS=30000
SCAN_TOOL_TIMEOUT_MS=60000

# Repo size cap. Checked twice: a best-effort pre-flight check against the
# GitHub/GitLab API before any container is even started, and always
# post-clone inside the clone container (the authoritative check - the
# pre-flight one can't see every repo, e.g. if the provider API is
# unreachable or rate-limited).
SCAN_MAX_REPO_SIZE_MB=500

# Host-side Docker orchestration (see src/services/scan/dockerRunner.js).
# SCAN_CONTAINER_TIMEOUT_MS is the hard wall-clock ceiling across BOTH
# containers combined - if it fires, the host force-kills whichever
# container is still running, whatever that container's own internal
# timeouts are doing.
SCAN_IMAGE=codeprint-scan-runner:latest
SCAN_CONTAINER_TIMEOUT_MS=300000
SCAN_CONTAINER_MEMORY=512m
SCAN_CONTAINER_CPUS=1
SCAN_CONTAINER_PIDS_LIMIT=128

# Rate limiting for POST /api/scan (per IP, in-memory - fine for a single
# backend instance; swap for a shared store like Redis before scaling out).
SCAN_RATE_LIMIT_WINDOW_MS=900000
SCAN_RATE_LIMIT_MAX=10

# SQLite database for scan history (GET /api/scans, GET /api/scans/:id).
# Created automatically (along with its parent directory) on first run.
DB_PATH=./data/codeprint.db
